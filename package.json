{
  "name": "gorfmusic-com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepages": "node scripts/prepages.mjs",
    "icons": "node scripts/generate-favicons.mjs",
    "dev": "npm run prepages && vite",
    "build": "tsc --noEmit && npm run prepages && vite build && node scripts/generate-route-fallbacks.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:html": "html-validate dist/**/*.html",
    "smoke:urls": "node scripts/smoke-extensionless-urls.mjs",
    "test:e2e": "playwright test",
    "test:e2e:compat": "playwright test e2e/smoke.spec.ts --project=chromium --project=firefox --project=webkit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "html-validate": "^11.6.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "to-ico": "^1.1.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  }
}
